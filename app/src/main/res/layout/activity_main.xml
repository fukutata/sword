<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <!-- ゲーム画面 -->
    <com.fukutata.sword.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- UI (Life/Enemy HP) -->
    <LinearLayout
        android:id="@+id/uiContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start">
            <TextView
                android:id="@+id/txtPlayerLife"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIFE: ❤❤❤❤❤"
                android:textColor="#FF2222"
                android:textSize="18sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/txtEnemyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENEMY"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginEnd="10dp"/>
            <ProgressBar
                android:id="@+id/enemyHP"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="300dp"
                android:layout_height="15dp"
                android:max="100"
                android:progress="100" />
        </LinearLayout>
    </LinearLayout>

    <!-- タイトル画面 -->
    <LinearLayout
        android:id="@+id/titleLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#000000">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textColor="#FFD700"
            android:textSize="50sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp"/>
        <Button
            android:id="@+id/btnStart"
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:text="@string/start_game" />
    </LinearLayout>

    <!-- 敵選択画面 -->
    <LinearLayout
        android:id="@+id/selectLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#1A1A1A">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_enemy"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:layout_marginBottom="20dp"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnSelectDragon" android:layout_width="180dp" android:layout_height="wrap_content" android:text="@string/enemy_dragon" android:layout_margin="10dp"/>
            <Button android:id="@+id/btnSelectGolem" android:layout_width="180dp" android:layout_height="wrap_content" android:text="@string/enemy_golem" android:layout_margin="10dp"/>
            <Button android:id="@+id/btnSelectBeholder" android:layout_width="180dp" android:layout_height="wrap_content" android:text="@string/enemy_beholder" android:layout_margin="10dp"/>
        </LinearLayout>
        <Button android:id="@+id/btnSelectDemonKing" android:layout_width="250dp" android:layout_height="wrap_content" android:text="@string/enemy_demon_king" android:visibility="gone" android:layout_marginTop="20dp"/>
    </LinearLayout>

    <!-- 技選択画面 -->
    <LinearLayout
        android:id="@+id/skillSelectLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#CC000000">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="技を選べ！"
            android:textColor="#00FF00"
            android:textSize="30sp"
            android:layout_marginBottom="30dp"/>
        <Button android:id="@+id/btnSkillDoubleJump" android:layout_width="300dp" android:layout_height="wrap_content" android:text="@string/learned_double_jump" android:layout_margin="5dp"/>
        <Button android:id="@+id/btnSkillDiveAttack" android:layout_width="300dp" android:layout_height="wrap_content" android:text="@string/learned_dive_attack" android:layout_margin="5dp"/>
        <Button android:id="@+id/btnSkillHadoken" android:layout_width="300dp" android:layout_height="wrap_content" android:text="@string/learned_hadoken" android:layout_margin="5dp"/>
    </LinearLayout>

    <!-- 操作パネル (白猫風バーチャルパッド) -->
    <RelativeLayout
        android:id="@+id/controllerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- 左半分どこでも反応するジョイスティック -->
        <com.fukutata.sword.JoystickView
            android:id="@+id/joystickView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toStartOf="@+id/buttonArea" />

        <!-- 攻撃・防御ボタンエリア -->
        <LinearLayout
            android:id="@+id/buttonArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="30dp"
            android:gravity="center">

            <Button android:id="@+id/btnGuard" android:text="防御" android:layout_width="85dp" android:layout_height="85dp" android:backgroundTint="#55BB55" android:layout_marginEnd="15dp"/>
            <Button android:id="@+id/btnLight" android:text="弱" android:layout_width="85dp" android:layout_height="85dp" android:backgroundTint="#4444BB" android:layout_marginEnd="15dp"/>
            <Button android:id="@+id/btnHeavy" android:text="強" android:layout_width="85dp" android:layout_height="85dp" android:backgroundTint="#BB4444"/>
        </LinearLayout>
    </RelativeLayout>

    <!-- 結果表示 -->
    <LinearLayout
        android:id="@+id/resultLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#CC000000"
        android:padding="40dp">
        <TextView android:id="@+id/txtResult" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFD700" android:textSize="40sp" android:gravity="center" />
        <Button android:id="@+id/btnRetry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/retry" android:layout_gravity="center" android:layout_marginTop="20dp" />
    </LinearLayout>
</RelativeLayout>